{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pfarre-schmelz",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pfarre-schmelz.hoferbaut.fyi", "custom_domain": true }],
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "spring-surf-245b.cloudflareaccess.com",
    "CF_ACCESS_AUD": "6758d6d27f8023b80a516af78f870a34f23b41e612b655756d7c45858c9c93fb"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pfarre-schmelz-db",
      "database_id": "8c2e68f6-48b9-42b3-a19b-01179c0a49d7",
      "migrations_dir": "drizzle"
    }
  ]
}
